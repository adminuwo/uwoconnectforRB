# .env.example
# Copy this file to .env and fill in real values before running the project.

# Django secret key – generate a strong random value for production
SECRET_KEY=your-secret-key-here

# Debug mode – set to False in production
DEBUG=False

# Allowed hosts – comma‑separated list of hostnames/Domains
ALLOWED_HOSTS=your.domain.com,localhost,127.0.0.1

# MongoDB connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_DB_NAME=aisaconnect_db

# Firebase service account – either JSON string or path to JSON file
# Option 1: Inline JSON (single‑line, escaped) – NOT RECOMMENDED for production
#FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option 2: Path to JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/serviceAccountKey.json

# Email configuration (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Azure storage (optional)
AZURE_ACCOUNT_NAME=your-azure-account
AZURE_ACCOUNT_KEY=your-azure-key
AZURE_CONTAINER=media

# Google Cloud storage (optional)
GS_BUCKET_NAME=your-gcs-bucket
GS_PROJECT_ID=your-gcp-project-id

# ── Razorpay (Platform Subscription Billing — UWOConnect's own account) ──────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Razorpay Technology Partner OAuth (Per-Client Payment Gateway) ───────────
# Required for clients to connect THEIR OWN Razorpay accounts to UWOConnect.
# Register as a Technology Partner at: https://razorpay.com/partners/technology-partner/
# Once approved, Razorpay provides a RAZORPAY_CLIENT_ID and RAZORPAY_CLIENT_SECRET.
# These are UWOConnect's platform-level credentials — NOT any client's credentials.
# Each client's own Razorpay credentials are obtained via OAuth and stored securely in DB.
RAZORPAY_CLIENT_ID=your_razorpay_partner_client_id
RAZORPAY_CLIENT_SECRET=your_razorpay_partner_client_secret
# Redirect URI must match what you registered in Razorpay Partner Dashboard
RAZORPAY_REDIRECT_URI=https://yourdomain.com/api/razorpay/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=https://yourdomain.com

# ── Meta / WhatsApp Cloud API Webhooks ─────────────────────────────────────────
# Inbound webhook HMAC-SHA256 signature verification uses META_APP_SECRET.
META_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=aisaconnect_secure_token

